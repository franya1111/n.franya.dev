# Порт, на якому слухатиме сайт на цьому сервері.
# Cloudflare Tunnel має вказувати на цей самий порт.
# За замовчуванням 3000. Якщо 3000 зайнятий — поміняй на 3001, 3002, ...
PORT=3000

# (Опціонально) URL твоєї бази даних SQLite.
# Залиш як є, якщо не знаєш що це.
DATABASE_URL=file:/app/data/custom.db

# У цьому проекту порти не пробросжуються назовні — трафік іде через
# Nginx Proxy Manager (NPM) через мережу my-test_default.
#
# Налаштовувати змінні тут взагалі не обов'язково — за замовчуванням все працює.
#
# єдине, що можна змінити — це DATABASE_URL, але для SQLite-бази
# краще залишити як є.

# (Опціонально) URL бази даних SQLite
DATABASE_URL=file:/app/data/custom.db
